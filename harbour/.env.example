NODE_ENV=dev
PORT=6000

# Connection strings
MONGODB_URI=mongodb://127.0.0.1:27017/harbour-db
REDIS_URI=redis://127.0.0.1:6379

# GeoLite MMDB path
MMDB_PATH=./src/data/GeoLite2-Country.mmdb

# Token encryption secret
# Generate it with `openssl rand -base64 32`
TOKEN_SECRET=

# Enables private router
PRIVATE_ROUTES=true

# Keys for Wii U token encryption
# Generate them with `openssl rand -hex 32`
KEYS_WIIU_IV=
KEYS_WIIU_KEY=

# Hub API settings
HUB_API_FQDN=
HUB_S2S_TOKEN=

# Keys for Pretendo token encryption
# Generate them with `openssl rand -hex 32`
PRETENDO_TOKEN_SECRET_KEY=
PRETENDO_TOKEN_IV=

# Admin emails (comma-separated)
AD_EMAILS=yunyl@ryuatelier.org,termy@ryuatelier.org

# Logs HTTP requests with all its details when set to true
LOG_HTTP_REQUESTS=true

# Dashboard admin secret — enter this on the login page to get a 7-day JWT
# Generate with: openssl rand -base64 32
ADMIN_TOKEN_SECRET=