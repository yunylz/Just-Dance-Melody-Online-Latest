{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  },
  "ts-node": {
    "files": true
  },
  "include": [
    "src/**/*"
  ],
  "files": [
    "src/types/express.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/og-backoffice/**/*",
    "src/og-jmcs/**/*",
    "src/og-jmcs2/**/*",
    "src/og-src/**/*",
    "**/*.mts"
  ]
}