    "axios": "^1.16.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-ip": "^1.0.4",
    "express-session": "^1.19.0",
    "joi": "^18.1.2",
    "maxmind": "^5.0.6",
    "mongoose": "^9.6.1",
    "morgan": "^1.10.1",
    "object-hash": "^3.0.0",
    "path-to-regexp": "^8.4.2",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "signale": "^1.4.0",
