{
  "name": "jmcs",
  "version": "1.5.0",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "build:dashboard": "npm run build --prefix dashboard",
    "build:all": "npm run build:dashboard && npm run build",
    "start": "node dist/src/server.js",
    "dev": "[[ $(uname) == 'Darwin' ]] && sh ./macos-services.sh; nodemon --watch 'src/**/*.ts' --exec 'tsx' src/server.ts",
    "dev:vps": "nodemon --ignore node_modules --ignore logs --exec tsx src/server.ts",
    "dev:dashboard": "npm run dev --prefix dashboard"
  },
