<!DOCTYPE html>
<html>
<head>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #1e3a8a, #7e22ce);
        }
        table {
            width: 100%;
            height: 100vh;
        }
        .container {
            background-color: rgba(17, 24, 39, 0.95);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            padding: 40px;
            max-width: 600px;
            margin: 20px auto;
        }
        h2 {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            margin: 0 0 16px;
            text-align: center;
        }
        p {
            font-size: 16px;
            color: #d1d5db;
            line-height: 1.6;
            margin: 0 0 24px;
            text-align: center;
        }
        input[type="password"] {
            width: 100%;
            max-width: 400px;
            padding: 12px;
            border: 1px solid #4b5563;
            border-radius: 8px;
            background-color: #1f2937;
            color: #ffffff;
            font-size: 16px;
            transition: border-color 0.3s ease;
        }
        input[type="password"]:focus {
            outline: none;
            border-color: #a78bfa;
            box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.2);
        }
        button {
            width: 100%;
            max-width: 400px;
            padding: 12px;
            background: linear-gradient(90deg, #a78bfa, #8b5cf6);
            border: none;
            border-radius: 8px;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(167, 139, 250, 0.3);
        }
        #error-message {
            color: #f87171;
            font-size: 14px;
            margin-bottom: 12px;
            text-align: center;
        }
        #result-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        #result-modal > div {
            background-color: #111827;
            border-radius: 12px;
            padding: 24px;
            max-width: 400px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }
        .modal-message {
            font-size: 16px;
            margin: 0 0 16px;
        }
        .modal-message.success {
            color: #34d399;
        }
        .modal-message.error {
            color: #f87171;
        }
        svg {
            transition: transform 0.3s ease;
        }
        svg:hover {
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center" valign="middle">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="container">
                    <tr>
                        <td align="center">

                            <!-- Title -->
                            <h2>JDMO Hub</h2>

                            <!-- Message -->
                            <p>Enter your new password below to reset your account password.</p>

                            <!-- Password Reset Form -->
                            <form id="reset-password-form" action="/auth/v1/reset-password?token=<%= encodeURIComponent(token) %>" method="POST">
                                <div style="margin-bottom:16px;">
                                    <input type="password" id="newPassword" name="newPassword"
                                        placeholder="New Password" required />
                                </div>
                                <p id="error-message" style="display:none;"></p>
                                <button type="submit">Reset Password</button>
                            </form>

                            <!-- Modal -->
                            <% if (showModal) { %>
                            <div id="result-modal">
                                <div>
                                    <p id="modal-message"
                                        class="modal-message <%= success ? 'success' : 'error' %>">
                                        <%= message %>
                                    </p>
                                </div>
                            </div>
                            <% } %>

                            <!-- Client-side Validation -->
                            <script>
                                document.getElementById('reset-password-form').addEventListener('submit', function (event) {
                                    const password = document.getElementById('newPassword').value;
                                    const errorMessage = document.getElementById('error-message');
                                    const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*])[A-Za-z\d!@#$%^&*]{8,32}$/;

                                    if (!passwordRegex.test(password)) {
                                        event.preventDefault();
                                        errorMessage.textContent =
                                            'Password must be 8-32 characters, with at least one uppercase letter, one lowercase letter, one number, and one special character (!@#$%^&*).';
                                        errorMessage.style.display = 'block';
                                    } else {
                                        errorMessage.style.display = 'none';
                                    }
                                });
                            </script>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>