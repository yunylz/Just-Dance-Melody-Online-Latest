# Proxy server port (default: 3128)
PORT=3128

# Target domain for proxying requests
HRBR_DOMAIN=harbour.example.com

# Pretendo domain to intercept
PRETENDO_DOMAIN=account.example.com

# US domains to proxy (comma-separated list)
# Note: Remove any spaces around commas for proper parsing
US_DOMAINS=us-services.example.com

# Authentication
REQUIRE_AUTH=true